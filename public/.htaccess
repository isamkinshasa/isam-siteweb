# Configuration Apache pour Next.js Export Statique (trailingSlash: true) & Sanity Studio sur LWS
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Redirection SPA Sanity Studio (/structure et toutes ses sous-routes)
  # Redirige /structure et toutes ses sous-routes (/structure/desk, /structure/intent...) vers /structure/index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^structure(/.*)?$ /structure/index.html [L]

  # 2. Support des dossiers avec trailing slash
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]

  # 3. Page d'erreur 404 personnalisée Next.js
  ErrorDocument 404 /404.html
</IfModule>
